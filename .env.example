# Copy to .env.local for local work. On Vercel, set these under Project Settings → Environment Variables.

# Postgres connection string (Neon, Supabase, or any Postgres).
# Leave empty to run in demo mode: orders live inside signed links and nothing is stored.
DATABASE_URL=

# Long random string used to sign order links and webhooks.
# Generate one with: openssl rand -base64 32
ORDER_SECRET=

# Payment provider. Only "mock" exists today.
PAYMENT_PROVIDER=mock

# --- Sign-in with social accounts (optional). See docs/LOGIN.md. ---
# Long random string for sign-in sessions. Generate with: openssl rand -base64 32
# Without it, no sign-in option is shown.
AUTH_SECRET=

# Each platform switches on when both of its values are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINE_ID=
AUTH_LINE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
AUTH_TIKTOK_ID=
AUTH_TIKTOK_SECRET=
