# Copy to .env.local for local work. On Vercel, set these under Project Settings → Environment Variables.

# Postgres connection string (Neon, Supabase, or any Postgres).
# Leave empty to run in demo mode: orders live inside signed links and nothing is stored.
DATABASE_URL=

# Long random string used to sign order links and webhooks.
# Generate one with: openssl rand -base64 32
ORDER_SECRET=

# Payment provider. Only "mock" exists today.
PAYMENT_PROVIDER=mock
